# Neon PostgreSQL (pooled connection string, add `-pooler` to the host)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection string (used by Prisma Migrate / `prisma db push`)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# BetterAuth
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Optional OAuth providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apps
SERVER_PORT="3000"
CORS_ORIGIN="http://localhost:5173"
VITE_API_URL="http://localhost:3000"
VITE_SOCKET_URL="http://localhost:3000"
