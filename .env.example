# Neon PostgreSQL
# - DATABASE_URL: direct connection string, used by Prisma CLI (migrate / db push)
# - DATABASE_URL_POOLED: pooled connection string (`-pooler` host), used at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# BetterAuth
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Optional OAuth providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase Storage (S3-compatible protocol)
# - S3_ENDPOINT: S3-compatible endpoint of the Supabase Storage bucket
# - S3_REGION: region configured for the storage endpoint
# - S3_BUCKET: public bucket that stores avatar objects
# - S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: storage access keys, never commit real values
# - S3_PUBLIC_URL: public base URL used to build publicly accessible avatar URLs
S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
S3_REGION="ap-northeast-1"
S3_BUCKET="collab-avatars"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL="https://<project-ref>.supabase.co/storage/v1/object/public/collab-avatars"

# Email (Resend)
# - FRONTEND_URL: base URL used to build invitation landing links
# - RESEND_API_KEY: when empty, invitation emails are printed to the server log instead
# - EMAIL_FROM: verified Resend sender, e.g. "Collab Board <onboarding@resend.dev>"
FRONTEND_URL="http://localhost:5173"
RESEND_API_KEY=""
EMAIL_FROM="Collab Board <onboarding@resend.dev>"

# Redis (optional)
# - REDIS_URL: leave empty to disable all Redis capabilities (dashboard cache,
#   BullMQ mail queue and the Socket.io Redis adapter all fall back gracefully).
# - Upstash example (TLS): "rediss://default:PASSWORD@host.upstash.io:6379"
# - Local example:         "redis://localhost:6379"
REDIS_URL=""

# Apps
SERVER_PORT="3000"
CORS_ORIGIN="http://localhost:5173"
VITE_API_URL="http://localhost:3000"
VITE_SOCKET_URL="http://localhost:3000"
