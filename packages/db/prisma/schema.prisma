// Prisma schema for the Collab Board application (Prisma 7).
//
// Connections are no longer declared here:
//   - Prisma CLI (migrate / db push / studio) -> `prisma.config.ts` (DATABASE_URL)
//   - Runtime PrismaClient -> `@prisma/adapter-neon` with DATABASE_URL_POOLED

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  COMMENT_ADDED
}

// ---------------------------------------------------------------------------
// BetterAuth models (email/password + OAuth + organization plugin)
// Model names are kept in PascalCase while tables stay snake_case/lowercase,
// which is what the BetterAuth Prisma adapter expects by default.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  lastActiveOrganizationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  members         Member[]
  sentInvitations Invitation[] @relation("InvitationInviter")
  createdTasks    Task[]       @relation("TaskCreator")
  assignedTasks   Task[]       @relation("TaskAssignee")
  comments        Comment[]
  notifications   Notification[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members     Member[]
  invitations Invitation[]
  projects    Project[]

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// Business models
// ---------------------------------------------------------------------------

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  key            String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("project")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(BACKLOG)
  priority    TaskPriority @default(MEDIUM)
  // Fractional index used for ordering inside a status column.
  position    Float        @default(1000)
  projectId   String
  assigneeId  String?
  creatorId   String
  dueDate     DateTime?
  // Set when the task enters DONE and cleared when it leaves DONE. Drives the
  // "completed per day" series on the dashboard (Asia/Shanghai buckets).
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User      @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([projectId, status, position])
  @@index([assigneeId])
  @@map("task")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  authorId  String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("comment")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  // Structured context stored as JSON: { taskId, taskTitle, projectId,
  // organizationId, actorName, commentSnippet? }. Keeps a single table while
  // staying easy to extend with new notification kinds.
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Product analytics (Phase 12)
//
// Append-only event log written by the `analytics` BullMQ worker (or directly
// when Redis is disabled). `userId` / `organizationId` are nullable because
// anonymous page views are accepted; the server never trusts a client-supplied
// user id — it injects the session's user when present.
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id              String   @id @default(cuid())
  eventName       String
  userId          String?
  organizationId  String?
  sessionId       String
  path            String
  properties      Json?
  // Client-reported event time (browser clock). Kept separate from the server
  // `createdAt` so trend charts reflect when the user actually acted.
  clientTimestamp DateTime
  createdAt       DateTime @default(now())

  @@index([organizationId, eventName, createdAt])
  @@map("analytics_event")
}
