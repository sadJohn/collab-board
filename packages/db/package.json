{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "validate": "prisma validate",
    "push": "prisma db push",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "dotenv": "^18.0.10",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2"
  }
}
